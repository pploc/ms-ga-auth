# Keeps the build context small and stops host build output leaking into the image, where it
# would shadow what the builder stage produces.
.git
.gradle
build

# IDE and editor state
.idea
.vscode
.cursor
.junie
.claude
*.iml
*.iws
*.ipr

# Local tooling and deployment config that has no business in an image
docker-compose*.yml
deploy
*.log
.DS_Store
